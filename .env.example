# Copy this file to .env and replace every example secret before starting services.
MYSQL_DATABASE=it_service_desk
DB_USERNAME=itsm_app
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
MYSQL_PORT=3307
DB_URL='jdbc:mysql://localhost:3307/it_service_desk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-local-admin-password
SESSION_COOKIE_SECURE=false
ASSET_UPLOAD_DIR=./var/uploads/assets
TICKET_UPLOAD_DIR=./var/uploads/tickets
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.test
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
SUPPORT_EMAIL=
WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
