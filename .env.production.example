# Copy to .env.production and replace all example values before deployment.
APP_HTTP_PORT=8088
PUBLIC_APP_ORIGIN=https://itsm.example.com

MYSQL_DATABASE=it_service_desk
DB_USERNAME=itsm_app
DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Set both values for the first start. The administrator is not overwritten later.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
SUPPORT_EMAIL=
